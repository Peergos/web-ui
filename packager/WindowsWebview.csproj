<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>PeergosWebView</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>winicon.ico</ApplicationIcon>
    <!-- net48 defaults to C# 7.3, which rejects <Nullable>enable</Nullable> outright
         (CS8630) - the build failed and shipped an MSI with no webview host. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
  </ItemGroup>
</Project>
